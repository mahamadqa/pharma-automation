<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    Group Selection (controlled via Jenkins → -Dgroups Maven property):
    ─────────────────────────────────────────────────────────────────────
    MODULE = Basic   →  -Dgroups=basic
    MODULE = Advance →  -Dgroups=advance
    MODULE = Both    →  -Dgroups=basic,advance   (default — runs all)
    ─────────────────────────────────────────────────────────────────────

    Listeners:
    ─────────────────────────────────────────────────────────────────────
    MyListener     → Screenshots on failure + ExtentReports logging
    RetryListener  → Auto-wires RetryAnalyzer to every @Test (max 2 retries)
    ─────────────────────────────────────────────────────────────────────
-->
<suite name="Pharma Automation Test Suite" verbose="1" parallel="classes" thread-count="4">

    <!-- ═══════════════════════════════════════════════════════════
         LISTENERS
         • MyListener    : Captures screenshot + logs to ExtentReport on failure
         • RetryListener : IAnnotationTransformer — applies RetryAnalyzer (2 retries)
                           to every @Test automatically, no code changes needed
         ═══════════════════════════════════════════════════════════ -->
    <listeners>
        <listener class-name="utils.MyListener"/>
        <listener class-name="utils.RetryListener"/>
    </listeners>

    <!--
        Parallel Execution Configuration:
        - parallel="classes" : Runs test classes concurrently across worker threads
        - thread-count="4"   : Number of concurrent threads
        - Execution Flow:
          * baseModules classes and sop.VerificationOfSOPMasterFlow run in parallel
          * sop.VerifySOPMasterFlowIfEffectivenessCheckRequired starts only after
            sop.VerificationOfSOPMasterFlow has fully completed (enforced via dependsOnMethods)
    -->
    <test name="Pharma Modules Test" parallel="classes" thread-count="4">
        <packages>
            <package name="baseModules"/>
            <package name="sop"/>
        </packages>
    </test>

</suite>
