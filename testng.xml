<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    Group Selection (controlled via Jenkins → -Dgroups Maven property):
    ─────────────────────────────────────────────────────────────────────
    MODULE = Basic   →  -Dgroups=basic
    MODULE = Advance →  -Dgroups=advance
    MODULE = Both    →  -Dgroups=basic,advance   (default — runs all)
    ─────────────────────────────────────────────────────────────────────

    Listeners:
    ─────────────────────────────────────────────────────────────────────
    MyListener     → Screenshots on failure + ExtentReports logging
    RetryListener  → Auto-wires RetryAnalyzer to every @Test (max 2 retries)
    ─────────────────────────────────────────────────────────────────────
-->
<suite name="Pharma Automation Test Suite" verbose="1" parallel="classes" thread-count="4">

    <!-- ═══════════════════════════════════════════════════════════
         LISTENERS
         • MyListener    : Captures screenshot + logs to ExtentReport on failure
         • RetryListener : IAnnotationTransformer — applies RetryAnalyzer (2 retries)
                           to every @Test automatically, no code changes needed
         ═══════════════════════════════════════════════════════════ -->
    <listeners>
        <listener class-name="utils.MyListener"/>
        <listener class-name="utils.RetryListener"/>
    </listeners>

    <!--
        Parallel Execution Configuration:
        - parallel="classes" : Runs test classes concurrently across worker threads
        - thread-count="4"   : Number of concurrent worker threads
        - Execution Flow:
          1. Root SOP Flow: sop.VerificationOfSOPMasterFlow runs first among SOP tests (alongside baseModules in parallel)
          2. Dependent SOP Flows: Once sop.VerificationOfSOPMasterFlow completes and makes Revision 1 effective,
             the 5 dependent classes execute concurrently in PARALLEL across worker threads:
             - sop.VerifySOPMasterFlowIfEffectivenessCheckRequired
             - sop.VerificationOfSOPRequestAndIssueFlowControlled
             - sop.VerificationOfSOPRequestAndIssueFlowForDisplay
             - sop.VerificationOfSOPFormatRequestAndIssueFlow
             - sop.VerificationOfSOPAnnexureRequestAndIssueFlow
             (enforced via dependsOnMethods="sop.VerificationOfSOPMasterFlow.verificationOfSOPMasterLifecycle")
    -->
    <test name="Pharma Modules Test" parallel="classes" thread-count="4">
        <classes>
            <!-- Root SOP Master Lifecycle Flow -->
            <class name="sop.VerificationOfSOPMasterFlow"/>

            <!-- Dependent SOP Flows (Run concurrently in parallel once root flow completes) -->
            <class name="sop.VerifySOPMasterFlowIfEffectivenessCheckRequired"/>
            <class name="sop.VerificationOfSOPRequestAndIssueFlowControlled"/>
            <class name="sop.VerificationOfSOPRequestAndIssueFlowForDisplay"/>
            <class name="sop.VerificationOfSOPFormatRequestAndIssueFlow"/>
            

            <!-- Base Modules (Run concurrently in parallel across worker threads) -->
            <class name="baseModules.CreateGRNFromPOFlow"/>
            <class name="baseModules.VerifySOShipmentInvoiceFlow"/>
        </classes>
    </test>

</suite>
