<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout pattern="%d{HH:mm:ss} [%t] %-5level %c - %msg%n" />
		</Console>

		<File name="FileLogger" fileName="logs/test.log">
			<PatternLayout
				pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %c - %msg%n" />
		</File>
	</Appenders>

	<Loggers>


		<!-- Disable TestNG internal logs -->
		<Logger name="org.testng" level="error" additivity="false">
			<AppenderRef ref="Console" />
		</Logger>

		<!-- Disable playwright verbose logs -->
		<Logger name="com.microsoft.playwright" level="error" additivity="false">
			<AppenderRef ref="Console" />
		</Logger>

		<Root level="info">
			<AppenderRef ref="Console" />
			<AppenderRef ref="FileLogger" />
		</Root>


	</Loggers>

</Configuration>